[Unit]
Description=BRO Production Runtime
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bro
Group=bro
WorkingDirectory=/opt/bro/current
EnvironmentFile=-/etc/bro/bro.env
EnvironmentFile=/etc/bro/bro.release.env
ExecStartPre=/usr/bin/python3 /opt/bro/current/scripts/production_status.py --preflight
ExecStart=/usr/bin/python3 /opt/bro/current/scripts/run_production_service.py
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
StateDirectory=bro
StateDirectoryMode=0750
RuntimeDirectory=bro
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=restart
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/bro /run/bro
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
