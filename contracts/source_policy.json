{
  "policy": "bro.governed-source-policy.v1",
  "purpose": "Which external hosts BRO may acquire study material from, what their word is worth, and what happens to a source nobody has classified. Discovery never confers trust; this file decides what a discovered candidate may become.",
  "tiers": {
    "A": {
      "name": "CANONICAL_PRIMARY",
      "statement": "Standards bodies, official project documentation, government technical frameworks, original specifications. Authoritative for what they themselves define and nothing else.",
      "auto_admit": true,
      "may_produce_verified_knowledge": true
    },
    "B": {
      "name": "ACADEMIC",
      "statement": "Recognized university material and original academic research.",
      "auto_admit": true,
      "may_produce_verified_knowledge": true
    },
    "C": {
      "name": "PROVEN_ENGINEERING",
      "statement": "Established engineering organizations and high-quality technical publications. Admitted only when the policy marks the family admissible, never automatically by tier alone.",
      "auto_admit": false,
      "may_produce_verified_knowledge": true
    },
    "D": {
      "name": "DISCOVERY_ONLY",
      "statement": "Blogs, forums, social media, Q&A sites, tutorials, video. May produce candidate leads. Never admitted to the study corpus, and never a source of VERIFIED durable knowledge.",
      "auto_admit": false,
      "may_produce_verified_knowledge": false
    },
    "UNCLASSIFIED": {
      "name": "UNCLASSIFIED",
      "statement": "A host no family claims. It stays a candidate awaiting a person; BRO never promotes it, because a system that can classify its own new sources can grant itself anything.",
      "auto_admit": false,
      "may_produce_verified_knowledge": false
    }
  },
  "families": [
