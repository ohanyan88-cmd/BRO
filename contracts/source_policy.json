  "denied_hosts": [
    "localhost",
    "127.0.0.1",
    "0.0.0.0",
    "169.254.169.254",
    "metadata.google.internal"
  ],
  "discovery_only_hosts": [
    "stackoverflow.com",
    "stackexchange.com",
    "reddit.com",
    "www.reddit.com",
    "medium.com",
    "dev.to",
    "quora.com",
    "x.com",
    "twitter.com",
    "youtube.com",
    "www.youtube.com",
    "facebook.com",
    "hashnode.dev",
    "substack.com"
  ],
  "budgets": {
    "max_response_bytes": 12000000,
    "max_normalised_characters": 400000,
    "max_redirects": 5,
    "timeout_seconds": 45,
    "max_attempts": 3,
    "host_interval_seconds": 1.5,
    "max_link_depth": 2,
    "max_pages_per_host": 12,
    "max_pages_per_mission": 40,
    "max_pdf_pages": 200
  },
  "allowed_content_types": [
    "text/html",
    "text/plain",
    "text/markdown",
    "text/x-rst",
    "application/pdf",
    "application/xhtml+xml",
    "application/json"
  ]
}
