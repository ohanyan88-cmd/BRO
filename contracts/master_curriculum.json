{
  "curriculum": "bro.master-engineering-and-ai-curriculum.v1",
  "purpose": "The long-lived study programme. A mission's CURRICULUM_COMPLETE means one bounded plan finished; this file is what says whether the programme is finished, and it answers from evidence rather than from a mission having mentioned a subject.",
  "coverage_rule": {
    "source_sufficiently_studied": {
      "min_verified_rows": 3,
      "statement": "A source counts as studied when it produced at least this many VERIFIED rows. Fewer than that is a document that was opened, not one that was learned from."
    },
    "domain_states": [
      "COVERED",
      "PARTIAL",
      "UNSTUDIED"
    ],
    "default_min_verified_rows": 12,
    "default_min_sources": 2,
    "statement": "A domain is COVERED only when enough distinct sufficiently-studied sources carry enough verified rows about it. One document, one mission or a pile of rows from a single source is PARTIAL, never COVERED.",
    "min_distinct_keywords": 2,
    "keyword_rule": "A row counts toward a domain only when it matches at least min_distinct_keywords of that domain's signals. Signals are the terminology authoritative upstream sources actually use, not phrases invented to be safe: the first version demanded 'ownership rule' and 'borrow checker' while the Rust Book says 'ownership' and 'borrowing', so thirty verified rows counted as one. Discrimination comes from requiring two distinct signals, not from making each signal rare -- a single generic word is still not evidence."
  },
  "revisit_reasons": [
    "CONTRADICTION",
    "STALE_SOURCE",
    "MISSING_VERIFICATION",
    "DEPENDENCY_DEPTH",
    "INSUFFICIENT_COVERAGE",
    "EXPLICIT_REFRESH"
  ],
