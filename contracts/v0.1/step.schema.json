{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bro.local/contracts/v0.1/step.schema.json",
  "title": "BRO Step v0.1",
  "x-bro-primitive": "Step",
  "x-bro-owner": "NERVOUS_SYSTEM",
  "type": "object",
  "additionalProperties": false,
  "required": ["step_id", "task_ref", "plan_ref", "plan_revision", "purpose", "dependencies", "required_capabilities", "expected_output", "authority_class", "verification_requirement", "retry_policy", "state", "revision", "created_at", "updated_at"],
  "properties": {
    "step_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "task_ref": {"$ref": "common.schema.json#/$defs/reference"},
    "plan_ref": {"$ref": "common.schema.json#/$defs/reference"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "purpose": {"type": "string", "minLength": 1},
    "dependencies": {"$ref": "common.schema.json#/$defs/stringArray"},
    "required_capabilities": {"$ref": "common.schema.json#/$defs/stringArray"},
    "expected_output": {"type": "string", "minLength": 1},
    "authority_class": {"type": "string", "minLength": 1},
    "verification_requirement": {"type": "string", "minLength": 1},
    "retry_policy": {"type": "string", "minLength": 1},
    "state": {"enum": ["PLANNED", "READY", "ACTIVE", "SUCCEEDED", "PARTIAL", "FAILED", "BLOCKED", "CANCELLED"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "updated_at": {"$ref": "common.schema.json#/$defs/timestamp"}
  }
}
