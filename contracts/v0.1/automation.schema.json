{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bro.local/contracts/v0.1/automation.schema.json",
  "title": "BRO Automation v0.1",
  "x-bro-primitive": "Automation",
  "x-bro-owner": "NERVOUS_SYSTEM",
  "type": "object",
  "additionalProperties": false,
  "required": ["automation_id", "project_boundary", "desired_outcome", "schedule_kind", "interval_seconds", "next_due_at", "misfire_policy", "max_catch_up", "status", "revision"],
  "properties": {
    "automation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "project_boundary": {"type": "string", "minLength": 1},
    "desired_outcome": {"type": "string", "minLength": 1},
    "schedule_kind": {"enum": ["INTERVAL"]},
    "interval_seconds": {"type": "integer", "minimum": 1},
    "next_due_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "misfire_policy": {"enum": ["COALESCE", "CATCH_UP"]},
    "max_catch_up": {"type": "integer", "minimum": 1},
    "status": {"enum": ["ACTIVE", "PAUSED", "CANCELLED"]},
    "revision": {"type": "integer", "minimum": 1}
  }
}
