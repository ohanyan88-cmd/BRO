{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bro.local/contracts/v0.1/observation.schema.json",
  "title": "BRO Observation v0.1",
  "x-bro-primitive": "Observation",
  "x-bro-owner": "PERCEPTION",
  "type": "object",
  "additionalProperties": false,
  "required": ["observation_id", "claim", "source", "provenance", "observed_at", "freshness", "trust_state", "scope", "limitations"],
  "properties": {
    "observation_id": {"$ref": "common.schema.json#/$defs/identifier"},
    "claim": {}, "raw_result_ref": {"type": ["string", "null"]},
    "source": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "common.schema.json#/$defs/record"},
    "observed_at": {"$ref": "common.schema.json#/$defs/timestamp"},
    "freshness": {"enum": ["CURRENT", "AGING", "STALE", "UNKNOWN"]},
    "trust_state": {"$ref": "common.schema.json#/$defs/claimState"},
    "scope": {"type": "string", "minLength": 1},
    "limitations": {"$ref": "common.schema.json#/$defs/stringArray"},
    "integrity": {"$ref": "common.schema.json#/$defs/record"}
  }
}

