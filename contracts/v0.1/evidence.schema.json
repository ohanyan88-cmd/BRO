{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bro.local/contracts/v0.1/evidence.schema.json",
  "title": "BRO Evidence v0.1",
  "x-bro-primitive": "Evidence",
  "x-bro-owner": "IMMUNE_SYSTEM",
  "type": "object",
  "additionalProperties": false,
  "required": ["evidence_id", "criterion", "evidence_type", "source", "provenance", "collection_method", "collected_at", "result", "scope", "limitations", "validity", "freshness", "verifier"],
  "properties": {
    "evidence_id": {"$ref": "common.schema.json#/$defs/identifier"}, "criterion": {"type": "string", "minLength": 1},
    "evidence_type": {"type": "string", "minLength": 1}, "source": {"type": "string", "minLength": 1},
    "provenance": {"$ref": "common.schema.json#/$defs/record"}, "collection_method": {"type": "string", "minLength": 1},
    "collected_at": {"$ref": "common.schema.json#/$defs/timestamp"}, "result": {}, "scope": {"type": "string", "minLength": 1},
    "limitations": {"$ref": "common.schema.json#/$defs/stringArray"}, "validity": {"enum": ["VALID", "INVALID", "UNVERIFIED", "EXPIRED"]},
    "freshness": {"enum": ["CURRENT", "AGING", "STALE", "UNKNOWN"]}, "verifier": {"type": "string", "minLength": 1}
  }
}

